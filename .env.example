# Public Cloudflare resource build values (IDs/names are not secrets)
MIKRAS_DEPLOY_TARGET=cloudflare
MIKRAS_D1_DATABASE_ID=replace-with-cloudflare-d1-database-id
MIKRAS_R2_BUCKET_NAME=mikras-marketing-media

# Configure these as encrypted runtime secrets/variables in Cloudflare.
ADMIN_EMAILS=admin@example.com
ADMIN_SETUP_TOKEN=generate-a-random-one-time-token-of-at-least-20-characters
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=MIKRAS Marketing <notifications@example.com>
